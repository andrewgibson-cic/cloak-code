#!/bin/bash
# CloakCode Control Script - Comprehensive Management Tool
# Inspired by SLAPENIR's operational excellence

set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$SCRIPT_DIR"

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
MAGENTA='\033[0;35m'
CYAN='\033[0;36m'
NC='\033[0m' # No Color

# Icons
ROCKET="🚀"
STOP="🛑"
CHECK="✅"
WARN="⚠️"
ERROR="❌"
INFO="ℹ️"
SHELL="🐚"
CLEAN="🧹"
HEALTH="🏥"
LOGS="📋"

# Helper functions
info() { echo -e "${CYAN}${INFO}${NC} $1"; }
success() { echo -e "${GREEN}${CHECK}${NC} $1"; }
warning() { echo -e "${YELLOW}${WARN}${NC} $1"; }
error() { echo -e "${RED}${ERROR}${NC} $1"; }
header() { 
    echo ""
    echo "=========================================="
    echo "  $1"
    echo "=========================================="
    echo ""
}

# Check prerequisites
check_docker() {
    if ! command -v docker &> /dev/null; then
        error "Docker not found! Please install Docker Desktop"
        echo "  Download: https://www.docker.com/products/docker-desktop"
        exit 1
    fi
    
    if ! docker info &> /dev/null; then
        error "Docker daemon not running! Please start Docker Desktop"
        exit 1
    fi
}

check_docker_compose() {
    if ! command -v docker-compose &> /dev/null && ! docker compose version &> /dev/null 2>&1; then
        error "docker-compose not found! Please install docker-compose"
        exit 1
    fi
}

# Detect docker-compose command (v1 vs v2)
DOCKER_COMPOSE="docker-compose"
if ! command -v docker-compose &> /dev/null; then
    DOCKER_COMPOSE="docker compose"
fi

check_env() {
    if [ ! -f ".env" ]; then
        warning ".env file not found!"
        info "Creating from template..."
        if [ -f ".env.template" ]; then
            cp .env.template .env
            success "Created .env from template"
            echo ""
            warning "Please edit .env with your real API keys before starting"
            echo ""
            echo "  ${CYAN}nano .env${NC}  # or use your favorite editor"
            echo ""
            echo "Required variables:"
            echo "  - OPENAI_API_KEY"
            echo "  - ANTHROPIC_API_KEY"
            echo "  - GITHUB_TOKEN (for git operations)"
            echo ""
            exit 1
        else
            error ".env.template not found!"
            exit 1
        fi
    fi
    
    # Validate critical variables exist
    if ! grep -q "OPENAI_API_KEY=" .env || ! grep -q "ANTHROPIC_API_KEY=" .env; then
        warning "Missing critical API keys in .env"
        info "Please ensure OPENAI_API_KEY and ANTHROPIC_API_KEY are set"
    fi
}

start() {
    header "${ROCKET} Starting CloakCode"
    
    check_docker
    check_docker_compose
    check_env
    
    info "Building and starting services..."
    $DOCKER_COMPOSE up -d --build
    
    info "Waiting for services to initialize (10s)..."
    sleep 10
    
    echo ""
    status
    
    echo ""
    success "CloakCode started successfully!"
    echo ""
    info "Access points:"
    echo "  • Proxy:  http://localhost:8080"
    echo "  • Health: http://localhost:8080/health"
    echo "  • Logs:   ${CYAN}./cloakcode logs${NC}"
    echo ""
}

stop() {
    header "${STOP} Stopping CloakCode"
    
    check_docker_compose
    
    info "Stopping all services..."
    $DOCKER_COMPOSE down
    
    success "All services stopped"
}

restart() {
    header "🔄 Restarting CloakCode"
    
    info "Stopping services..."
    $DOCKER_COMPOSE down
    
    echo ""
    start
}

status() {
    header "${HEALTH} CloakCode Status"
    
    # Check if docker-compose is available
    if ! check_docker_compose &> /dev/null; then
        error "docker-compose not available"
        return 1
    fi
    
    # Check if services are running
    if ! $DOCKER_COMPOSE ps 2>/dev/null | grep -q "Up"; then
        warning "Services are not running"
        echo ""
        info "Start with: ${CYAN}./cloakcode start${NC}"
        return 0
    fi
    
    info "Service Health:"
    echo ""
    
    # Check Proxy
    if docker ps --format '{{.Names}}' | grep -q "cloakcode.*proxy\|safe-claude.*proxy"; then
        if curl -s -f http://localhost:8080/health > /dev/null 2>&1; then
            success "Proxy        - http://localhost:8080 ${GREEN}(healthy)${NC}"
        else
            warning "Proxy        - http://localhost:8080 ${YELLOW}(not responding)${NC}"
        fi
    else
        error "Proxy        - ${RED}(not running)${NC}"
    fi
    
    # Check Agent
    if docker ps --format '{{.Names}}' | grep -q "cloakcode.*agent\|safe-claude.*agent"; then
        success "Agent        - ${GREEN}(running)${NC}"
    else
        error "Agent        - ${RED}(not running)${NC}"
    fi
    
    echo ""
    info "Quick commands:"
    echo "  • View logs:    ${CYAN}./cloakcode logs${NC}"
    echo "  • Open shell:   ${CYAN}./cloakcode shell${NC}"
    echo "  • Restart:      ${CYAN}./cloakcode restart${NC}"
}

logs() {
    service="${1:-}"
    
    header "${LOGS} Viewing Logs"
    
    if [ -z "$service" ]; then
        info "Following all logs (Ctrl+C to exit)..."
        $DOCKER_COMPOSE logs -f --tail=100
    else
        info "Following $service logs (Ctrl+C to exit)..."
        $DOCKER_COMPOSE logs -f --tail=100 "$service"
    fi
}

shell() {
    service="${1:-agent}"
    
    header "${SHELL} Opening Shell: $service"
    
    # Check if service is running
    if ! docker ps --format '{{.Names}}' | grep -q "cloakcode.*$service\|safe-claude.*$service"; then
        error "$service container is not running"
        info "Start services with: ${CYAN}./cloakcode start${NC}"
        exit 1
    fi
    
    info "Opening interactive shell in $service container..."
    echo ""
    
    # Find the actual container name
    container_name=$(docker ps --format '{{.Names}}' | grep -E "cloakcode.*$service|safe-claude.*$service" | head -n 1)
    
    if [ -z "$container_name" ]; then
        error "Could not find container for service: $service"
        exit 1
    fi
    
    # Determine shell type
    if [ "$service" = "agent" ]; then
        docker exec -it "$container_name" /bin/sh
    elif [ "$service" = "proxy" ]; then
        docker exec -it "$container_name" /bin/sh
    else
        docker exec -it "$container_name" /bin/sh
    fi
}

clean() {
    header "${CLEAN} Cleaning CloakCode"
    
    warning "This will remove all containers, volumes, and data!"
    read -p "Are you sure? (yes/no): " confirm
    
    if [ "$confirm" != "yes" ]; then
        info "Cancelled"
        exit 0
    fi
    
    info "Stopping services..."
    $DOCKER_COMPOSE down -v 2>/dev/null || true
    
    info "Removing volumes..."
    docker volume rm -f safe-claude-workspace safe-claude-logs 2>/dev/null || true
    
    success "Cleanup complete"
    info "Run '${CYAN}./cloakcode start${NC}' to initialize from scratch"
}

test() {
    header "🧪 Running Tests"
    
    info "Running test suite..."
    
    if [ -f "tests/run_tests.sh" ]; then
        bash tests/run_tests.sh
    else
        warning "Test script not found"
        info "Available tests:"
        echo "  • Unit tests:        ${CYAN}pytest tests/unit/${NC}"
        echo "  • Integration tests: ${CYAN}pytest tests/integration/${NC}"
        echo "  • Security tests:    ${CYAN}pytest tests/security/${NC}"
    fi
}

validate() {
    header "🔍 Validating Configuration"
    
    check_env
    
    info "Checking configuration files..."
    
    # Check proxy config
    if [ -f "proxy/config.yaml" ]; then
        success "proxy/config.yaml exists"
    else
        warning "proxy/config.yaml not found (will use defaults)"
    fi
    
    # Check docker-compose
    if [ -f "docker-compose.yml" ]; then
        success "docker-compose.yml exists"
        
        # Validate docker-compose syntax
        if $DOCKER_COMPOSE config > /dev/null 2>&1; then
            success "docker-compose.yml is valid"
        else
            error "docker-compose.yml has syntax errors"
            $DOCKER_COMPOSE config
            exit 1
        fi
    else
        error "docker-compose.yml not found"
        exit 1
    fi
    
    # Check critical environment variables
    info "Checking environment variables..."
    if grep -q "DUMMY" .env; then
        warning "Found DUMMY credentials in .env - replace with real values"
    fi
    
    success "Configuration validation complete"
}

usage() {
    cat << EOF
CloakCode Control Script - Universal API Credential Injector

${CYAN}Usage:${NC}
  ./cloakcode <command> [options]

${CYAN}Commands:${NC}
  ${GREEN}start${NC}      Start all services (builds if needed)
  ${GREEN}stop${NC}       Stop all services
  ${GREEN}restart${NC}    Restart all services
  ${GREEN}status${NC}     Show service status and health
  ${GREEN}logs${NC}       Follow logs (all services or specific)
  ${GREEN}shell${NC}      Open shell in container (default: agent)
  ${GREEN}clean${NC}      Remove all containers, volumes, and data
  ${GREEN}test${NC}       Run test suite
  ${GREEN}validate${NC}   Validate configuration files

${CYAN}Examples:${NC}
  ./cloakcode start              ${BLUE}# Start everything${NC}
  ./cloakcode status             ${BLUE}# Check health${NC}
  ./cloakcode logs               ${BLUE}# View all logs${NC}
  ./cloakcode logs proxy         ${BLUE}# View proxy logs only${NC}
  ./cloakcode shell              ${BLUE}# Shell into agent${NC}
  ./cloakcode shell proxy        ${BLUE}# Shell into proxy${NC}
  ./cloakcode restart            ${BLUE}# Restart everything${NC}
  ./cloakcode clean              ${BLUE}# Deep clean${NC}

${CYAN}Quick Start:${NC}
  1. cp .env.template .env       ${BLUE}# Create config${NC}
  2. nano .env                   ${BLUE}# Add your API keys${NC}
  3. ./cloakcode start           ${BLUE}# Start services${NC}
  4. ./cloakcode status          ${BLUE}# Verify health${NC}

${CYAN}Documentation:${NC}
  • README.md                    ${BLUE}# Main documentation${NC}
  • docs/QUICK_START.md          ${BLUE}# Quick start guide${NC}
  • docs/ADDING_CREDENTIALS.md   ${BLUE}# Add new credentials${NC}

${CYAN}Access Points:${NC}
  • Proxy:  http://localhost:8080
  • Health: http://localhost:8080/health

EOF
}

# Main command handler
case "${1:-}" in
    start)
        start
        ;;
    stop)
        stop
        ;;
    restart)
        restart
        ;;
    status)
        status
        ;;
    logs)
        logs "${2:-}"
        ;;
    shell)
        shell "${2:-agent}"
        ;;
    clean)
        clean
        ;;
    test)
        test
        ;;
    validate)
        validate
        ;;
    help|--help|-h)
        usage
        ;;
    *)
        if [ -z "${1:-}" ]; then
            usage
        else
            error "Unknown command: $1"
            echo ""
            usage
            exit 1
        fi
        ;;
esac