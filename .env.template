# SafeClaude Environment Variables Template
# Copy this file to .env and fill in your real API keys
# NEVER commit the .env file to version control
#
# NEW: This system now supports ANY API credential!
# Simply add credentials to credentials.yml and reference them here.
# The proxy will automatically inject them based on host whitelisting.

# ============================================================================
# SEMANTIC SCHOLAR CREDENTIALS
# ============================================================================
# Get from: https://www.semanticscholar.org/product/api#api-key
S2_API_KEY=your-semantic-scholar-api-key-here

# ============================================================================
# ADD MORE CREDENTIALS AS NEEDED
# ============================================================================

# OpenAI API Key
# Get from: https://platform.openai.com/api-keys
REAL_OPENAI_API_KEY=sk-proj-your-key-here

# GitHub Personal Access Token (for API access)
# Get from: https://github.com/settings/tokens
REAL_GITHUB_TOKEN=ghp_your-token-here

# ============================================================================
# GIT PAT TOKENS (for git operations via HTTPS)
# ============================================================================

# GitHub PAT for git operations (clone, push, pull)
# Get from: https://github.com/settings/tokens
# Required scopes: repo (for private repos), public_repo (for public repos)
GIT_GITHUB_PAT=ghp_your-git-pat-token-here

# GitLab PAT for git operations
# Get from: https://gitlab.com/-/profile/personal_access_tokens
# Required scopes: read_repository, write_repository
GIT_GITLAB_PAT=glpat-your-gitlab-token-here

# Bitbucket App Password for git operations
# Get from: https://bitbucket.org/account/settings/app-passwords/
# Required permissions: Repositories (Read, Write)
GIT_BITBUCKET_PAT=your-bitbucket-app-password-here

# Azure DevOps PAT for git operations
# Get from: https://dev.azure.com/{organization}/_usersSettings/tokens
# Required scopes: Code (Read & Write)
GIT_AZURE_PAT=your-azure-devops-pat-here

# Anthropic API Key (if using direct API)
# Get from: https://console.anthropic.com/settings/keys
REAL_ANTHROPIC_API_KEY=sk-ant-your-key-here

# Google Gemini API Key
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSyYourGeminiAPIKeyHere

# AWS Credentials
# Get from: https://console.aws.amazon.com/iam/home#/security_credentials
REAL_AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
REAL_AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY

# ============================================================================
# CRYPTOCURRENCY / TRADING PLATFORMS
# ============================================================================

# Binance API Key
# Get from: https://www.binance.com/en/support/faq/how-to-create-api-keys-on-binance-360002502072
REAL_BINANCE_API_KEY=your-binance-api-key-here

# ============================================================================
# E-COMMERCE PLATFORMS
# ============================================================================

# eBay OAuth Token
# Get from: https://developer.ebay.com/api-docs/static/oauth-tokens.html
REAL_EBAY_OAUTH_TOKEN=v^1.1#i^1#your-ebay-token-here

# ============================================================================
# PAYMENT PROCESSING
# ============================================================================

# Stripe Secret Key
# Get from: https://stripe.com/docs/keys
REAL_STRIPE_SECRET_KEY=sk_live_your-stripe-key-here

# ============================================================================
# COMMUNICATION APIS
# ============================================================================

# Twilio Auth Token
# Get from: https://www.twilio.com/console
REAL_TWILIO_AUTH_TOKEN=your-twilio-auth-token-here

# SendGrid API Key
# Get from: https://app.sendgrid.com/settings/api_keys
REAL_SENDGRID_API_KEY=SG.your-sendgrid-api-key-here

# ============================================================================
# IBM SERVICES
# ============================================================================

# IBM OpenAI-Compatible API (for IBM Consulting Assistants)
# Get from: IBM Consulting Assistants (ICA) - Composite Key
# Base URL: https://servicesessentials.ibm.com/apis/v3
IBM_API_KEY=your-ibm-composite-key-here
IBM_BASE_URL=https://servicesessentials.ibm.com/apis/v3
IBM_MODEL_ID=global/anthropic.claude-sonnet-4-5-20250929-v1:0

# ============================================================================
# COLLABORATION PLATFORMS
# ============================================================================

# Slack Bot Token (for bot-level operations)
# Get from: https://api.slack.com/authentication/token-types
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token-here

# Slack App Token (for Socket Mode and app-level operations)
# Get from: https://api.slack.com/authentication/token-types
SLACK_APP_TOKEN=xapp-your-slack-app-token-here

# Slack Signing Secret (for request verification)
# Get from: https://api.slack.com/apps -> Your App -> Basic Information
SLACK_SIGNING_SECRET=your-slack-signing-secret-here

# Discord Bot Token
# Get from: https://discord.com/developers/applications
REAL_DISCORD_BOT_TOKEN=your-discord-bot-token-here

# ============================================================================
# ADD YOUR CUSTOM CREDENTIALS BELOW
# ============================================================================
# Follow the pattern: REAL_<SERVICE>_<CREDENTIAL_TYPE>=value
# Then add the corresponding configuration to credentials.yml
#
# Example for a new service:
# REAL_MYSERVICE_API_KEY=your-api-key-here
